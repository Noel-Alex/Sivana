{
  "manifest_version": 3,
  "name": "Sivana",
  "version": "0.1.0",
  "description": "Hear it. Name it. Tab-audio recognition fingerprinted locally in Rust/WASM.",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "host_permissions": ["http://127.0.0.1:8077/*", "http://localhost:8077/*"],
  "action": {
    "default_title": "Sivana — listen to this tab",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "offline_enabled": false
}
